# Bookshelf server configuration. Copy to .env and adjust; .env is gitignored.
# Every variable is optional.

# Port for the server. It always binds to 127.0.0.1 (loopback only).
PORT=4380

# Where the database, cover cache and backups live.
# Default: ~/Library/Application Support/Bookshelf
# BOOKSHELF_DATA_DIR=

# IANA timezone used to bucket reading sessions into days. Default: system timezone.
# BOOKSHELF_TZ=Europe/London

# Optional Google Books API key (raises the anonymous quota).
# GOOGLE_BOOKS_API_KEY=

# Notion mirror (both required to enable it). See README "Notion setup".
# NOTION_TOKEN=
# NOTION_PARENT_PAGE_ID=
