{
  "name": "bookshelf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "dexie": "4.4.7",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "29.1.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  },
  "scripts": {
    "dev": "node --run dev:server & node --run dev:web; wait",
    "dev:server": "node --watch --watch-path=server --watch-path=shared server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production node server/index.ts",
    "icons": "node scripts/generate-icons.ts",
    "service:install": "node scripts/service.ts install",
    "service:uninstall": "node scripts/service.ts uninstall",
    "service:status": "node scripts/service.ts status",
    "service:logs": "node scripts/service.ts logs",
    "tailscale:serve": "node scripts/tailscale.ts serve",
    "tailscale:status": "node scripts/tailscale.ts status",
    "tailscale:off": "node scripts/tailscale.ts off",
    "import:bookpine": "node scripts/import-bookpine.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage"
  }
}
